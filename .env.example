# Hermes Agent 环境变量示例
# 复制为 .env 后填写真实值：copy .env.example .env

# ========== 主模型（见 config.yaml model.provider）==========
# 当前默认：deepseek + deepseek-v4-flash
DEEPSEEK_API_KEY=
# 备用 GPT（分析段可切 openai-api + gpt-5.4）
OPENAI_API_KEY=
# Vision 辅助（auxiliary.vision.provider: pplx）
PERPLEXITY_API_KEY=
# 备用：Gemini / 独立 pplx Agent
GOOGLE_API_KEY=
# PERPLEXITY_AGENT_API_KEY=

# ========== MCP / 爬虫 ==========
WEIBO_COOKIE=
APIFY_TOKEN=apify_api_HyO7IHumOYvVFRV086UsF6iSxDTByS2feW7a
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
BRIGHTDATA_MCP_URL=

# ========== 代理（按需） ==========
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=172.200.200.4,localhost,127.0.0.1,192.168.3.124,192.168.3.171,*.weibo.cn,weibo.cn,api.apify.com,apify.com,.apify.com

# ========== MySQL（01 账号采集） ==========
HERMES_DB_HOST=127.0.0.1
HERMES_DB_PORT=3306
HERMES_DB_USER=root
HERMES_DB_PASSWORD=123456
HERMES_DB_NAME=hermes-xa
# 入库 Hook 总开关（0=关闭）
HERMES_PERSIST_ENABLED=1

# ========== 图片资产（HBase）==========
# Python 写走现成 HTTP 接口（与「图片hbase入库.py」一致）
# Java 读走 ZK 原生；ZK 必须指向 insertHbaseData 实际落库的集群
HERMES_HBASE_ENABLED=1
HERMES_HBASE_INSERT_URL=http://192.168.3.171:6666/insertHbaseData
HERMES_HBASE_ZK=192.168.3.171
HERMES_HBASE_ZK_PORT=2181
HERMES_HBASE_IMAGE_TABLE=collect_image_bytes
HERMES_HBASE_COLUMN_FAMILY=info
# 关闭 HBase 时的本地回退目录
# HERMES_IMAGE_LOCAL_DIR=D:/hermes-xa/data/image_bytes
HERMES_IMAGE_MAX_BYTES=20971520
HERMES_IMAGE_MAX_RETRIES=3
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8642
# API_SERVER_KEY=至少 16 位，不可用占位符；生成示例: openssl rand -hex 32

# 完整变量列表见 Hermes 官方 .env 模板（install 后 hermes-agent 目录内）
