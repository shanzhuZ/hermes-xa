# video2frame-mcp 可选环境变量（也可写在仓库根 .env）

# 视频本地根目录（默认 {HERMES_HOME}/data/video_bytes）
# HERMES_VIDEO_LOCAL_DIR=

# 下载
# HERMES_VIDEO_CONNECT_TIMEOUT=15
# HERMES_VIDEO_READ_TIMEOUT=300
# HERMES_VIDEO_MAX_BYTES=209715200
# HERMES_VIDEO_MAX_RETRIES=3
# YouTube 反爬（二选一）：cookies.txt 或从浏览器读
# HERMES_VIDEO_YTDLP_COOKIES=D:/hermes-xa/mcp/data/youtube-cookies.txt
# HERMES_VIDEO_YTDLP_COOKIES_FROM_BROWSER=chrome
# HERMES_VIDEO_PROXY=  （默认继承 HTTPS_PROXY）
# 另需：pip install "yt-dlp[default]"（含 yt-dlp-ejs）+ 本机 Node>=22（PATH 可找到 node）

# 抽帧间隔（秒）
# HERMES_VIDEO_FRAME_INTERVAL_SEC=3
# 只分析视频前 N 秒（默认 120=前2分钟）
# HERMES_VIDEO_MAX_ANALYZE_SEC=120

# VLM（默认 Perplexity sonar，与 auxiliary.vision 一致）
# HERMES_VIDEO_VLM_API_URL=https://api.perplexity.ai/chat/completions
# HERMES_VIDEO_VLM_MODEL=sonar
# PERPLEXITY_API_KEY=  （或 HERMES_VIDEO_VLM_API_KEY=）
# 若改回本地 32B：
# HERMES_VIDEO_VLM_API_URL=http://172.200.200.1:2015/v1/chat/completions
# HERMES_VIDEO_VLM_MODEL=Qwen2.5-VL-32B-Instruct
# HERMES_VIDEO_VLM_PROMPT=请用中文分析本帧画面。先完整描述正常可见内容，不要省略；末尾固定补充【地点】与【涉华】两行。
# HERMES_VIDEO_VLM_SUMMARY_PROMPT=保留正常内容概括，并单独归纳【地点】【涉华】；无涉华写「未见明显涉华因素」。
# HERMES_VIDEO_VLM_MAX_TOKENS=800
# HERMES_VIDEO_VLM_CONCURRENCY=3
