{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "parentId": { "type": "keyword" },
      "name": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 256 }
        }
      },
      "level": { "type": "integer" },
      "type": { "type": "keyword" },
      "description": { "type": "text" },
      "status": { "type": "keyword" },
      "version": { "type": "keyword" },
      "creator": { "type": "keyword" },
      "createTime": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd||epoch_millis||strict_date_optional_time"
      },
      "badgeCount": { "type": "integer" },
      "displayConfig": {
        "properties": {
          "show": { "type": "boolean" },
          "weight": { "type": "integer" },
          "displayCount": { "type": "integer" }
        }
      },
      "stats": {
        "properties": {
          "childCount": { "type": "integer" },
          "accountCount": { "type": "integer" },
          "platformCount": { "type": "integer" },
          "lastActive": { "type": "keyword" }
        }
      }
    }
  }
}
